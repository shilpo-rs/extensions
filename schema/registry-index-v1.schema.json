{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SignedRegistryIndex",
  "type": "object",
  "properties": {
    "index": {
      "$ref": "#/$defs/RegistryIndex"
    },
    "signature": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "index",
    "signature"
  ],
  "$defs": {
    "Capability": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "events": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/EventKind"
              }
            },
            "kind": {
              "type": "string",
              "const": "events:subscribe"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "events"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "wallpaper:set"
            },
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/WallpaperSource"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "sources"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "wallpaper:read"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "theme:read"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "theme:set_source"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "notifications:show"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "clipboard:read"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "clipboard:write"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "actions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string",
              "const": "actions:invoke"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "actions"
          ]
        },
        {
          "type": "object",
          "properties": {
            "hosts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string",
              "const": "network:http"
            },
            "paths": {
              "type": "array",
              "default": [],
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "hosts"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "filesystem:read"
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "paths"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "filesystem:write"
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "paths"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "location:read"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "secrets"
            },
            "purposes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SecretPurpose"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "purposes"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "search:provide"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "EventKind": {
      "type": "string",
      "enum": [
        "outputs_changed",
        "theme_changed",
        "palette_generated",
        "wallpaper_changed",
        "network_changed",
        "media_changed",
        "power_changed",
        "timer_fired",
        "workspace_changed"
      ]
    },
    "ExtensionId": {
      "description": "The package identity of an extension (reverse-domain notation, e.g. `io.github.alice`).",
      "type": "string"
    },
    "KeyRotationDelegation": {
      "type": "object",
      "properties": {
        "authorized_by_registry": {
          "type": "boolean",
          "default": false
        },
        "next_public_key": {
          "type": "string"
        },
        "previous_public_key": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "previous_public_key",
        "next_public_key",
        "signature"
      ]
    },
    "RegistryIndex": {
      "type": "object",
      "properties": {
        "generated_at": {
          "type": "string"
        },
        "releases": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/RegistryRelease"
          }
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "source_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source_id",
        "generated_at"
      ]
    },
    "RegistryRelease": {
      "type": "object",
      "properties": {
        "api_version": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Capability"
          }
        },
        "capabilities_hash": {
          "type": "string"
        },
        "channel": {
          "$ref": "#/$defs/ReleaseChannel"
        },
        "data_only": {
          "type": "boolean",
          "default": false
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/ExtensionId"
        },
        "key_rotation": {
          "anyOf": [
            {
              "$ref": "#/$defs/KeyRotationDelegation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "min_shilpo_version": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "official": {
          "type": "boolean",
          "default": false
        },
        "open_source": {
          "type": "boolean",
          "default": false
        },
        "package_hash": {
          "type": "string"
        },
        "package_url": {
          "type": "string"
        },
        "published_at": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "publisher_public_key": {
          "type": "string"
        },
        "publisher_signature": {
          "type": "string"
        },
        "verified_publisher": {
          "type": "boolean",
          "default": false
        },
        "version": {
          "type": "string"
        },
        "yanked": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "publisher",
        "version",
        "api_version",
        "min_shilpo_version",
        "channel",
        "package_url",
        "package_hash",
        "publisher_public_key",
        "publisher_signature",
        "capabilities_hash",
        "published_at"
      ]
    },
    "ReleaseChannel": {
      "type": "string",
      "enum": [
        "stable",
        "beta",
        "development"
      ]
    },
    "SecretPurpose": {
      "type": "string"
    },
    "WallpaperSource": {
      "type": "string",
      "enum": [
        "extension_asset",
        "local_file",
        "remote"
      ]
    }
  }
}
