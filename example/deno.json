{
  "minimumDependencyAge": 0,
  "imports": {
    "@shilpo/ext-sdk": "jsr:@shilpo/ext-sdk@0.1.0",
    "@shilpo/ext-sdk/builder": "jsr:@shilpo/ext-sdk@0.1.0/builder",
    "@shilpo/ext-sdk/manifest": "jsr:@shilpo/ext-sdk@0.1.0/manifest",
    "@shilpo/ext-sdk/testing": "jsr:@shilpo/ext-sdk@0.1.0/testing",
    "@std/assert": "jsr:@std/assert@1"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-env tests/",
    "check": "deno check src/**/*.ts tests/**/*.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "semiColons": true,
    "singleQuote": false,
    "indentWidth": 2,
    "lineWidth": 100
  }
}
