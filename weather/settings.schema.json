{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "location": {
      "type": "string",
      "title": "Location",
      "description": "A city or postal code. Exact coordinates take precedence.",
      "default": ""
    },
    "latitude": {
      "type": [
        "number",
        "null"
      ],
      "title": "Latitude",
      "minimum": -90,
      "maximum": 90,
      "default": null
    },
    "longitude": {
      "type": [
        "number",
        "null"
      ],
      "title": "Longitude",
      "minimum": -180,
      "maximum": 180,
      "default": null
    },
    "temperature_unit": {
      "type": "string",
      "title": "Temperature unit",
      "enum": [
        "celsius",
        "fahrenheit"
      ],
      "default": "celsius"
    },
    "refresh_minutes": {
      "type": "integer",
      "title": "Refresh interval",
      "minimum": 15,
      "maximum": 180,
      "default": 30
    },
    "show_condition": {
      "type": "boolean",
      "title": "Show condition text",
      "default": false
    }
  }
}

